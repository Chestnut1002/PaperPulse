# ===== PaperPulse 环境变量示例 =====
# 复制为 .env 并填入真实值（.env 不提交）

# --- LLM API（ai-service）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 可选：Semantic Scholar API key（ai-service）---
# 不填也能用，但匿名共享池经常返回 429；免费申请后填这里可走独立配额
SEMANTIC_SCHOLAR_API_KEY=

# --- MySQL（docker compose）---
MYSQL_ROOT_PASSWORD=paperpulse123
DB_URL=jdbc:mysql://localhost:3306/paperpulse?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=paperpulse123

# --- JWT（backend）---
JWT_SECRET=
JWT_EXPIRATION=86400

# --- 服务端口 ---
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
