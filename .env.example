# ===== PaperPulse 环境变量示例 =====
# 复制为 .env 并填入真实值（.env 不提交）
#
# ⚠️ 这个文件在仓库里、是公开的：**任何字段都不要填真实值**。
#    下面留空表示"必须由你填"，不是"默认值"。未填时程序会明确报错，而不是静默降级。

# --- LLM API（ai-service）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 可选：Semantic Scholar API key（ai-service）---
# 不填也能用，但匿名共享池经常返回 429；免费申请后填这里可走独立配额
SEMANTIC_SCHOLAR_API_KEY=

# --- MySQL（docker compose）---
# 留空时 docker compose 会直接拒绝启动并提示（见 docker-compose.yml）
MYSQL_ROOT_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/paperpulse?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# --- JWT（backend）---
# **必填**，且必须是足够长的随机串（至少 32 字节）。例如：
#   openssl rand -base64 48
# 用公开过的字符串当密钥，等于把"伪造任意用户登录凭证"的方法一并公开。
JWT_SECRET=
JWT_EXPIRATION=86400

# --- 服务端口 ---
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
