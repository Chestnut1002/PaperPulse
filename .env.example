# ============================================================
#  PaperPulse 配置指引
# ============================================================
#
#  三个组件要配置,但它们**各读各的文件** —— 填错地方不会报错,
#  只会静默不生效。先把下面这张表看明白,再看每一段的说明:
#
#    ① docker compose  →  仓库根目录 .env        ← 把本文件复制过去就是它
#    ② ai-service      →  ai-service/.env        ← 复制 ai-service/.env.example
#    ③ backend         →  application-local.yml  ← 不读 .env,别填在上面两份里
#
#    前端不需要任何配置。
#
#  ⚠️ 本文件在公开仓库里,写的是**格式**不是**值**。
#     你的真实口令与密钥只写进复制出来的那几份文件 —— 它们都已被 .gitignore 忽略。
# ============================================================


# ────────────────────────────────────────────────────────────
#  ① 仓库根目录 .env      (只有 docker compose 读这个文件)
# ────────────────────────────────────────────────────────────

# MySQL 容器的 root 口令。**必填。**
#
# 未设置时 `docker compose up -d mysql` 会直接拒绝启动并打印原因 ——
# 不会退回某个默认口令默默跑起来。
#
# 自己生成一个,别用 123456 这类:`openssl rand -base64 18`
MYSQL_ROOT_PASSWORD=

# 用 docker compose 起 MySQL 的话,③ 里连数据库要用的口令
# **就是这个值** —— 容器是用它初始化的。位置不同,值必须一致。
# (② 的 ai-service 不连数据库,与它无关。)


# ────────────────────────────────────────────────────────────
#  ② ai-service/.env      (只有 ai-service 读这个文件)
#
#  下面把要填的项目列全,方便你一次看明白;
#  真正要复制去填的那份模板在 ai-service/.env.example,内容相同:
#
#      cp ai-service/.env.example ai-service/.env
# ────────────────────────────────────────────────────────────

# DeepSeek 的 API key。**必填** —— 检索 Agent 和精读问答都靠它调模型。
#
# 申请:https://platform.deepseek.com/api_keys
# 不填的后果:所有需要调用模型的接口都会失败。
DEEPSEEK_API_KEY=

# 接口地址。**一般不用改** —— 只有走自建服务或代理时才需要改。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名。**一般不用改** —— 想换模型时才改,例如 deepseek-reasoner。
DEEPSEEK_MODEL=deepseek-chat

# Semantic Scholar 的 key。**可选** —— 不填也能检索,
# 但走匿名共享池,连续请求容易被限流(HTTP 429)。
# 免费申请后填上可走自己的独立配额:https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=


# ────────────────────────────────────────────────────────────
#  ③ backend      —— 它不读 .env,所以这里没有可填的行
#
#  Spring Boot 没有 .env 这个机制,它只认「环境变量」和 application-local.yml。
#
#  本机开发的做法:新建下面这个文件(该路径已被 .gitignore 忽略,不会提交)
#
#      backend/src/main/resources/application-local.yml
#
#  内容照抄,把尖括号换成你自己的值:
#
#      jwt:
#        secret: <必填,用 openssl rand -base64 48 生成>
#      spring:
#        datasource:
#          username: <你的 MySQL 用户名,通常是 root>
#          password: <你的 MySQL 口令>
#
#  为什么 jwt.secret 不给默认值:JWT 的签名密钥一旦公开,任何人都能签发一个
#  冒充任意用户的 token,而服务端验签会通过。默认值会把「忘记配置」变成
#  「用一个公开密钥静默运行」,两者在运行期表现完全一样。
#
#  全部可配置项及其对应的环境变量名(DB_URL / DB_USERNAME / DB_PASSWORD /
#  BACKEND_PORT / JWT_EXPIRATION / AI_SERVICE_BASE_URL ...)见
#      backend/src/main/resources/application.yml
#  每个键都标了默认值,想改哪个改哪个。
# ────────────────────────────────────────────────────────────
